{
  "manifest_version": 3,
  "name": "SilentGuard",
  "version": "1.1.0",
  "description": "Monitor browser security risks and protect your online accounts",
  "minimum_chrome_version": "111",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "cookies",
    "management",
    "webRequest",
    "declarativeNetRequest",
    "browsingData",
    "contextMenus",
    "downloads",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "panic": {
      "suggested_key": { "default": "Ctrl+Shift+9" },
      "description": "Trigger panic mode"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SilentGuard",
    "default_icon": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["page-hooks.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png"
  }
}
